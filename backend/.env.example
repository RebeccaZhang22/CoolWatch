# Copy to backend/.env and fill local credentials.

# The main Agent and Suffix Probe use the Qwen3-32B OpenAI-compatible server.
VLLM_BASE_URL=http://127.0.0.1:8978/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=qwen3-32b

# The customer Agent uses two isolated endpoints: a normal business model for
# user-visible answers and a probe-capable shadow model for server-side replay.
CUSTOMER_AGENT_BUSINESS_VLLM_BASE_URL=http://127.0.0.1:8104/v1
CUSTOMER_AGENT_SHADOW_VLLM_BASE_URL=http://127.0.0.1:8013/v1
# Backwards-compatible alias for older deployments (points to business).
CUSTOMER_AGENT_VLLM_BASE_URL=http://127.0.0.1:8104/v1
CUSTOMER_AGENT_MODEL=qwen3-8b
CUSTOMER_AGENT_SHADOW_MODEL=qwen3-8b
# Set false when using an ordinary, unpatched vLLM. The console then omits
# Activation Probe and SafeGauge while retaining the independent baselines.
CUSTOMER_AGENT_ENABLE_RUNTIME_PROBES=true

# Qwen3Guard runs as its own small vLLM service.
QWEN3_GUARD_BACKEND=openai
QWEN3_GUARD_BASE_URL=http://127.0.0.1:8001/v1
QWEN3_GUARD_API_KEY=EMPTY
QWEN3_GUARD_MODEL=qwen3guard-8b
QWEN3_GUARD_MAX_NEW_TOKENS=128

# Meta Llama Prompt Guard 2 model ID, or a caller-supplied local directory.
LLAMA_PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
LLAMA_PROMPT_GUARD_THRESHOLD=0.5
LLAMA_PROMPT_GUARD_MAX_LENGTH=512
LLAMA_PROMPT_GUARD_DEVICE=auto

# In-process Suffix Probe MLP. Its task/model checkpoint is selected automatically.
SAFEGAUGE_PROCESSOR_PATH=
SAFEGAUGE_TOKENIZER_PATH=
SAFEGAUGE_DEVICE=cpu
SAFEGAUGE_TIMEOUT_SECONDS=120

# Use the legacy Transformers service or score inside the patched vLLM worker.
ACTIVATION_PROBE_BACKEND=standalone
ACTIVATION_PROBE_BASE_URL=http://127.0.0.1:8910
ACTIVATION_PROBE_TIMEOUT_SECONDS=300
# Set ACTIVATION_PROBE_BACKEND=vllm to score in the patched vLLM worker.
# Leave this empty to use the vLLM URL selected by each chat request.
ACTIVATION_PROBE_VLLM_BASE_URL=

# Patched-vLLM Inline Probing remains specific to indirect prompt injection.
INLINE_PROBING_PROTOCOL=inline_probing
INLINE_PROBING_TASK=indirect_prompt_injection
INLINE_PROBING_PROBE_ID=qwen3-8b-indirect-prompt-injection-assistant-prefix-probing
INLINE_PROBING_EXPECTED_CHECKPOINT_ID=sha256:41f1433346caebc8b2e9ff5640b44e3d162050d6ef7ffee45285badba4798b45
INLINE_PROBING_THRESHOLD=0.5
INLINE_PROBING_TIMEOUT_SECONDS=120

NETEASE_YIDUN_SECRET_ID=
NETEASE_YIDUN_SECRET_KEY=
NETEASE_YIDUN_BUSINESS_ID=

# Optional overrides.
NETEASE_YIDUN_API_URL=https://as.dun.163.com/v5/text/check
NETEASE_YIDUN_VERSION=v5.2
NETEASE_YIDUN_SIGNATURE_METHOD=
NETEASE_YIDUN_TIMEOUT_SECONDS=2
NETEASE_YIDUN_CHECK_LABELS=
