# Copy to backend/.env and fill local credentials.

# The main Agent and SafeGauge share the same Qwen3.5 vLLM service.
VLLM_BASE_URL=http://127.0.0.1:8768/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen3.5-27B

# Local Meta Llama Prompt Guard 2 classifier (weights stay outside this repository).
LLAMA_PROMPT_GUARD_MODEL=../models/Llama-Prompt-Guard-2-86M
LLAMA_PROMPT_GUARD_THRESHOLD=0.5
LLAMA_PROMPT_GUARD_MAX_LENGTH=512
LLAMA_PROMPT_GUARD_DEVICE=auto

# Standalone SafeGauge service.
SAFEGAUGE_BASE_URL=http://127.0.0.1:8900
SAFEGAUGE_TIMEOUT_SECONDS=120

NETEASE_YIDUN_SECRET_ID=
NETEASE_YIDUN_SECRET_KEY=
NETEASE_YIDUN_BUSINESS_ID=

# Optional overrides.
NETEASE_YIDUN_API_URL=http://as.dun.163.com/v5/text/check
NETEASE_YIDUN_VERSION=v5.2
NETEASE_YIDUN_SIGNATURE_METHOD=
NETEASE_YIDUN_TIMEOUT_SECONDS=2
NETEASE_YIDUN_CHECK_LABELS=
