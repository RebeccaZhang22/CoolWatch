      "配网"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "query": {"type": "string"}
      },
      "required": ["query"]
    }
  },
  {
    "name": "lookup_order",
    "description": "按订单号查询商城演示订单，返回商品、实付金额、订单节点、签收时间和审核路由字段。消息中出现具体订单号时使用。",
    "required_when_any": ["CS-"],
    "parameters": {
      "type": "object",
      "properties": {
        "order_id": {"type": "string"}
