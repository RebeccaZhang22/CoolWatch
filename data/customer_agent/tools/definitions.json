[
  {
    "name": "search_knowledge_base",
    "description": "按客户问题检索现行帮助中心文章、商品指南和售后运营手册，返回带来源标识的参考资料。涉及规则、公告或产品说明时使用。",
    "required_when_any": [
      "知识库",
      "公告",
      "退款规则",
