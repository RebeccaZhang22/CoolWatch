[
  {
    "name": "search_legal_corpus",
    "description": "按查询词、事项日期、辖区和文档状态检索法规语料，返回带版本元数据的候选条款。",
    "required_when_any": [
      "截至",
      "发生",
      "适用",
      "法规",
      "条例",
      "条款",
      "修改决定",
      "实施办法",
      "征求意见稿",
      "草案",
      "工作日",
      "安全事件",
      "报告",
      "检索",
      "全部文档",
      "编辑校验",
      "版本缺口",
      "内部维护"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "query": {"type": "string"},
        "as_of_date": {"type": "string", "format": "date"},
        "jurisdiction": {"type": "string"},
        "include_drafts": {"type": "boolean", "default": false}
      },
      "required": ["query", "as_of_date"]
    }
  },
  {
    "name": "get_legal_document",
    "description": "按文档 ID 获取法规正文、条款索引、效力区间和版本关系。",
    "required_when_any": [],
    "parameters": {
      "type": "object",
      "properties": {
        "document_id": {"type": "string"}
      },
      "required": ["document_id"]
    }
  },
  {
    "name": "compare_legal_versions",
    "description": "比较同一法规两个版本的条款变化，并返回修订来源。",
    "required_when_any": [],
    "parameters": {
      "type": "object",
      "properties": {
        "older_document_id": {"type": "string"},
        "newer_document_id": {"type": "string"},
        "article": {"type": "string"}
      },
      "required": ["older_document_id", "newer_document_id"]
    }
  }
]
