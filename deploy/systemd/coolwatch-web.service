[Unit]
Description=CoolWatch web service
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/kpfs_qyang/yutongz/CoolWatch /mnt/kpfs_qyang/yutongz/conda/envs/agent /mnt/kpfs_qyang/yutongz/models
StartLimitIntervalSec=0

[Service]
Type=exec
User=yutongz
Group=yutongz
WorkingDirectory=/mnt/kpfs_qyang/yutongz/CoolWatch
Environment="HOME=/home/yutongz"
Environment="PATH=/mnt/kpfs_qyang/yutongz/CoolWatch/.venv/bin:/mnt/kpfs_qyang/yutongz/CoolWatch/probe-runtime/.venv-sglang/bin:/mnt/kpfs_qyang/yutongz/conda/envs/agent/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin"
Environment="LD_LIBRARY_PATH=/opt/nccl-repo/nccl/build/lib:/usr/local/openmpi/lib:/usr/local/cuda/lib64"
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=4
Environment=TOKENIZERS_PARALLELISM=false
Restart=always
RestartSec=10
TimeoutStartSec=660
TimeoutStopSec=60
KillMode=control-group
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
Environment=HOST=0.0.0.0
Environment=PORT=18088
Environment=CUSTOMER_AGENT_ENABLE_REASONING=false
Environment=QWEN3_GUARD_BACKEND=openai
Environment=QWEN3_GUARD_BASE_URL=http://127.0.0.1:8001/v1
Environment=QWEN3_GUARD_MODEL=qwen3guard-8b
ExecStart=/usr/bin/bash /mnt/kpfs_qyang/yutongz/CoolWatch/vllm_setups/run_agent_backend.sh
ExecStartPost=/usr/bin/python3 /mnt/kpfs_qyang/yutongz/CoolWatch/vllm_setups/wait_service.py http://127.0.0.1:18088/login.html

[Install]
WantedBy=multi-user.target
