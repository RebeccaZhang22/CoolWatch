# Manager-only settings. Copy to manager/.env; do not use backend/.env.
# Optional provisioning on server startup (password must have at least 8 characters).
# Prefer the interactive CLI: .venv/bin/python -m manager.auth --email owner@example.com
MANAGER_EMAIL=
MANAGER_PASSWORD=

# Relative paths resolve from manager/, independent of the process working directory.
MANAGER_DATA_DIR=data
# Read-only metadata from the existing demo; its credentials are not imported.
MANAGER_USER_DB=../.runtime/prospectmonitor.db
MANAGER_USAGE_LOG=../.runtime/usage_events.jsonl
