[Unit]
Description=CoolWatch request activation shadow model on GPU7
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=yutongz
Group=yutongz
WorkingDirectory=/mnt/kpfs_qyang/yutongz/CoolWatch
Environment=CUDA_VISIBLE_DEVICES=7
ExecStart=/usr/bin/bash /mnt/kpfs_qyang/yutongz/CoolWatch/sglang-activation-runtime/deploy/run_model.sh shadow
ExecStartPost=/usr/bin/python3 /mnt/kpfs_qyang/yutongz/CoolWatch/vllm_setups/wait_service.py http://127.0.0.1:8303/health
Restart=on-failure
RestartSec=10
TimeoutStartSec=660
TimeoutStopSec=60
KillMode=control-group
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
